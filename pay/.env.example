# Copy to .env on the server. Never commit .env. docs/donations.md explains each step.

# mainnet for real XMR, stagenet for free test coins. Each network needs its own wallet file.
MONERO_NETWORK=stagenet
WALLET_FILE=donations-stagenet

# A Monero node as host:port. It sees this server's IP address, never the view key.
MONERO_DAEMON=

# Used once, to create the view-only wallet on first start. The spend key never goes here.
MONERO_ADDRESS=
MONERO_VIEW_KEY=
MONERO_RESTORE_HEIGHT=

# Encrypts the wallet file at rest.
WALLET_PASSWORD=

# Public hostname of this server (point its DNS A record here) and the site allowed to call it.
PAY_DOMAIN=pay.permanentunderclass.me
ALLOWED_ORIGINS=https://permanentunderclass.me

# Optional. Defaults shown.
# REQUIRED_CONFIRMATIONS=10
# CREATES_PER_IP_PER_HOUR=10
# CREATES_PER_HOUR=200
# MONERO_EXTRA_ARGS=
